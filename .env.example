# ── Core application ──────────────────────────────────────────────
SKILL_TAXONOMY_PATH=data/skills.json
MIN_SKILL_CONFIDENCE=0.5
TOP_KEYWORDS_COUNT=20
ATS_THRESHOLD_LOW=40.0
ATS_THRESHOLD_MEDIUM=65.0
MAX_FILE_SIZE=5242880

# ── FastAPI base URL (used by the Streamlit dashboard) ────────────
DEFAULT_API_BASE=http://localhost:8000
FASTAPI_API_BASE=http://localhost:8000

# ── LLM gateway (default route) ───────────────────────────────────
OPENAI_BASE_URL=https://api.experientiallabs.ai/v1
EXPERIENTIAL_ORG_KEY=your_experiential_org_key

# ── Native provider keys (optional — leave blank if unused) ───────
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Default model per provider ────────────────────────────────────
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_MODEL=deepseek-v4-flash
DEEPSEEK_MODEL=deepseek-chat
OPENAI_MODEL=gpt-4o-mini
CLAUDE_MODEL=claude-3-5-haiku-20241022
OLLAMA_MODEL=llama3.2

# ── Observability ─────────────────────────────────────────────────
LLM_PROCESSING_LOG=data/llm_processing.jsonl

# ── Optional Ollama (local inference) ─────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434/api/generate

# ── Optional per-provider quota limits (RPM/RPD/TPM) ──────────────
# GEMINI_QUOTA_RPM=15
# GEMINI_QUOTA_RPD=1500
# GEMINI_QUOTA_TPM=1000000
