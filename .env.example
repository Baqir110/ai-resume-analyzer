# ── Core application ──────────────────────────────────────────────
SKILL_TAXONOMY_PATH=data/skills.json
MIN_SKILL_CONFIDENCE=0.5

# Real semantic embeddings instead of TF-IDF cosine similarity, for the ATS
# analyser's skill matching. Measured on this repository: two paraphrases of the
# same achievement score 0.574 cosine similarity against 0.044 for unrelated
# text, so the embeddings carry meaning rather than word overlap.
#
# Costs a ~90 MB model download on first use and about 15 seconds to load, both
# once per process. Leave it false for a deployment that has not installed
# sentence-transformers; ats_analyzer.py then falls back to TF-IDF silently and
# says so in the log.
#
# Availability depends on the interpreter. sentence-transformers pulls
# transformers, which needs regex>=2025.10.22, and python-jobspy pins
# regex<2025.0.0. Both cannot hold in one environment, so:
#   Python 3.13  jobspy is not installed, so there is no conflict -- available.
#   Python 3.11/3.12  jobspy is installed and the pin wins -- not available.
ENABLE_SEMANTIC_EMBEDDINGS=false

TOP_KEYWORDS_COUNT=20
ATS_THRESHOLD_LOW=40.0
ATS_THRESHOLD_MEDIUM=65.0
MAX_FILE_SIZE=5242880
MAX_PACKAGE_BYTES=26214400
MAX_REQUEST_BYTES=31457280

# Rate limiting, for a shared deployment.
#
# Off by default: this application is built to run on one machine, and a limiter
# that starts refusing a single-user deployment is worse than none. Turn it on
# for anything with more than one user. API_KEY is a shared secret rather than a
# per-user identity, so a burst through it spends the configured provider's token
# budget and the operator gets 429s from the provider a moment later.
#
# Counters are in memory and per process: with N workers the effective limit is
# this many requests per worker.
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Required for job submission and tracker/log mutation endpoints. Generate a
# long random value and keep it in a secret manager, never in the profile.
API_KEY=replace-with-a-long-random-secret
CORS_ORIGINS=["http://127.0.0.1:8501","http://localhost:8501"]
ALLOWED_FILE_ROOTS=["data"]
APPLICANT_PROFILE_PATH=data/applicant_profile.local.yaml
JOB_ALLOWED_HOSTS=[]
AUTOMATIC_APPLY=false
AUTOMATIC_SUBMIT=false
DASHBOARD_CONTROL_ENABLED=false

# ── FastAPI base URL (used by the Streamlit dashboard) ────────────
DEFAULT_API_BASE=http://localhost:8000
FASTAPI_API_BASE=http://localhost:8000

# ── LLM routing ──────────────────────────────────────────────────────────
# The provider and the model are chosen here, and nowhere else. Changing either
# requires no change to any application code.
#
# LLM_MODE decides whether a request may leave this machine. It is the only
# setting that distinguishes "local only" from "local first", so it takes
# precedence over the older LLM_PROVIDER / LLM_ROUTE_MODE pair.
#
#   auto    Prefer the local provider (Ollama, or a local gateway) for normal CV
#           work. Fall back to the online chain if the local provider is
#           unavailable, times out, or the prompt does not fit its window.
#   ollama  Force local inference. On failure an error is returned; the CV is
#           never silently sent to a cloud provider.
#   online  Use the online chain only, and never touch a local provider.
LLM_MODE=auto

# Used when LLM_MODE is unset, and honoured by LLM_MODE=auto as the first
# candidate. Any registered provider name is valid.
LLM_PROVIDER=ollama

# Legacy. Honoured only when LLM_MODE is unset.
#   direct       exactly one provider, no fallback
#   automatic    local first, then the online chain
#   experiential route through the Experiential Labs gateway
LLM_ROUTE_MODE=automatic

# May a failed provider be replaced by the next candidate?
#   true   (default) automatic mode may fail over
#   false  exactly one provider, whatever happens
# Combine with LLM_MODE=ollama to guarantee a CV is never sent off the machine.
LLM_FALLBACK_ENABLED=true

# Hard ceiling on how many (provider, model) pairs one request may try. The
# candidate list is finite, but its length depends on how many providers are
# configured, so this bounds the cost independently of that. Minimum 1.
LLM_MAX_PROVIDER_ATTEMPTS=4

# Order of the online chain for LLM_MODE=auto and LLM_MODE=online. Both are
# optional; any other provider with a key set is appended after them.
ONLINE_PRIMARY_PROVIDER=gemini
ONLINE_FALLBACK_PROVIDER=openrouter

# Extra attempts after a failed generation, on top of the first. 0 means exactly
# one attempt. Only genuinely transient failures are retried -- a bad key, a bad
# model id, an exhausted balance or an empty response are not, because an
# identical request produces an identical result. Routing already fails over
# between providers, so 0 is usually right; raise it for a rate-limited cloud
# provider.
LLM_RETRIES=0

# Seconds of backoff per retry attempt.
LLM_RETRY_BACKOFF_SECONDS=1.5

# Ceiling applied to every provider that has no ceiling of its own. A
# per-provider variable below always wins.
# LLM_MAX_TOKENS=2048

# Per-request timeout for any provider without its own.
# LLM_REQUEST_TIMEOUT_SECONDS=180

# Timeout for model discovery, so a status call cannot hang.
# LLM_DISCOVERY_TIMEOUT_SECONDS=10

# ══════════════════════════════════════════════════════════════════════════
# PROVIDERS
# ══════════════════════════════════════════════════════════════════════════
# Each block is: base URL, credential, model, output ceiling. A provider is used
# as soon as its credential (if it needs one) and model are set. Blanks are
# fine; nothing here is required.
#
# Model identifiers below are EXAMPLES. They are not promises: provider
# catalogues change, and a model that was free last month may be gone, renamed
# or metered now. Nothing here is treated as permanently free. If a model id
# stops working, run
#
#     python -m scripts.llm_smoke --list <provider>
#
# to see what the provider currently offers, then set the variable.

# ── Ollama (local, free, no account) ─────────────────────────────────────
# Install: https://ollama.com/download then `ollama pull <model>`
# See what is already installed: `ollama list`
#
# Both endpoints work and the application detects which is configured:
#
#   .../api/generate   Native. Honours num_ctx and think:false, so the whole
#                      prompt is analysed. Recommended.
#   .../v1             OpenAI-compatible shim. Its 2048-token window holds the
#                      prompt AND the completion together, and no request field
#                      raises it (measured on ollama 0.34.4). The application
#                      sizes the output ceiling to what is left after the prompt
#                      and skips the local provider for a request whose prompt
#                      leaves too little room, logging which of the two happened.
OLLAMA_BASE_URL=http://localhost:11434/api/generate

# Any model Ollama serves. It does not have to be one of these:
#   qwen3:8b, qwen2.5:7b, llama3.2, llama3, deepseek-r1:8b, ...
# A name that is not installed yet is still accepted; the health check reports
# the `ollama pull` command that fixes it.
OLLAMA_MODEL=qwen3:8b

# Output ceiling. OLLAMA_MAX_OUTPUT_TOKENS is accepted as a legacy alias; the
# short name wins when both are set. Never degenerates to 0.
OLLAMA_MAX_TOKENS=2048

# Largest context window, ignored by the /v1 shim. Unset, it is derived from
# free VRAM and the model's KV-cache geometry, which is what stops a large
# window from spilling the model onto the CPU.
# OLLAMA_MAX_CONTEXT_TOKENS=12288
# OLLAMA_VRAM_HEADROOM_MB=1024

# ── OmniRoute (local gateway, free options, key optional) ────────────────
# A gateway, not a model. OMNIROUTE_MODEL=auto lets it choose; an explicit
# model id pins the choice. Leave the key blank when the gateway runs without
# authentication -- a local gateway with no key is sent no Authorization header
# at all, rather than a placeholder one.
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=auto
OMNIROUTE_MAX_TOKENS=2048

# ── Gemini ───────────────────────────────────────────────────────────────
# Free tier available; quotas and model names change.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_TOKENS=2048

# ── Groq ─────────────────────────────────────────────────────────────────
# Free tier available; quotas and model names change.
GROQ_API_KEY=
GROQ_MODEL=<configured-model>
GROQ_MAX_TOKENS=2048

# ── OpenRouter ───────────────────────────────────────────────────────────
# Aggregator. Model ids and any free routing change frequently; set this
# explicitly, or leave it unset to use the provider's own default.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=<configured-model>
OPENROUTER_MAX_TOKENS=2048

# ── Cerebras ─────────────────────────────────────────────────────────────
# No default model is shipped: the catalogue changes, and a stale id would send
# the CV to a model that no longer exists. Set it, or discover it.
CEREBRAS_API_KEY=
CEREBRAS_MODEL=
CEREBRAS_MAX_TOKENS=2048

# ── Cloudflare Workers AI ────────────────────────────────────────────────
# The account id is part of the base URL, so set the full
# https://api.cloudflare.com/client/v4/ai/<account>/v1 value.
CLOUDFLARE_API_KEY=
CLOUDFLARE_MODEL=
CLOUDFLARE_MAX_TOKENS=2048

# ── GitHub Models ────────────────────────────────────────────────────────
# Available models depend on repository permissions.
GITHUB_MODELS_API_KEY=
GITHUB_MODELS_MODEL=
GITHUB_MODELS_MAX_TOKENS=2048

# ── Hugging Face Inference Router ────────────────────────────────────────
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=
HUGGINGFACE_MAX_TOKENS=2048

# ── OpenAI (paid) ────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=<configured-model>
OPENAI_MAX_TOKENS=2048

# ── Anthropic / Claude (paid) ────────────────────────────────────────────
# Also accepted as LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=<configured-model>
CLAUDE_MAX_TOKENS=4096

# ── DeepSeek ─────────────────────────────────────────────────────────────
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_MAX_TOKENS=2048

# ── Experiential Labs (gateway, OpenAI-compatible) ────────────────────────
EXPLABS_API_KEY=
EXPERIENTIAL_MODEL=<configured-model>
EXPERIENTIAL_MAX_TOKENS=2048

# ══════════════════════════════════════════════════════════════════════════
# Observability
# ══════════════════════════════════════════════════════════════════════════
LLM_PROCESSING_LOG=data/llm_processing.jsonl

# Optional per-provider quota limits (RPM/RPD/TPM)
# GEMINI_QUOTA_RPM=15
# GEMINI_QUOTA_RPD=1500
# GEMINI_QUOTA_TPM=1000000

# ══════════════════════════════════════════════════════════════════════════
# Advanced overrides
# ══════════════════════════════════════════════════════════════════════════
# Nothing below is required. Each is an alternative name or an override, listed
# once here rather than repeated per provider.

# Alternative credential names, accepted in the order shown. The first one set
# wins. Useful when the secret already exists in your environment under a
# different name, so it does not have to be copied into a second variable.
#   gemini         GEMINI_API_KEY, then GOOGLE_API_KEY
#   claude         ANTHROPIC_API_KEY
#   openai         OPENAI_API_KEY
#   groq           GROQ_API_KEY
#   openrouter     OPENROUTER_API_KEY
#   deepseek       DEEPSEEK_API_KEY
#   cloudflare     CLOUDFLARE_API_KEY, then CLOUDFLARE_API_TOKEN
#   github         GITHUB_MODELS_API_KEY, then GITHUB_TOKEN
#   huggingface    HUGGINGFACE_API_KEY, then HF_TOKEN
#   experiential   EXPLABS_API_KEY, then EXPERIENTIAL_ORG_KEY

# Base-URL overrides. Each provider has a working default; set one of these to
# point at a proxy, a gateway, a regional endpoint, or a self-hosted deployment.
# Remote base URLs are validated: HTTPS is required and loopback and private
# addresses are rejected. Local providers (Ollama, OmniRoute) are exempt,
# because plain HTTP on a non-standard port is what a gateway on your own
# machine needs.
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# OPENAI_DIRECT_BASE_URL=https://api.openai.com/v1
# CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
# CLOUDFLARE_BASE_URL=https://api.cloudflare.com/client/v4/ai/<account>/v1
# GITHUB_MODELS_BASE_URL=https://models.github.ai/inference
# HUGGINGFACE_BASE_URL=https://router.huggingface.co/v1
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# The Experiential gateway's base URL. This is the historical name for it and
# is kept, because OPENAI_DIRECT_BASE_URL is what OpenAI itself uses.
# OPENAI_BASE_URL=https://api.experientiallabs.ai/v1

# Extra HTTP headers, as NAME=value pairs. Needed by a gateway that requires a
# routing header.
# OPENROUTER_EXTRA_HEADERS=X-Title=My CV App

# ══════════════════════════════════════════════════════════════════════════
# Checking the configuration
# ══════════════════════════════════════════════════════════════════════════
#   python -m scripts.llm_smoke              send a harmless prompt to every
#                                            configured provider, report
#                                            latency and token usage
#   python -m scripts.llm_smoke --list       show what each provider offers
#   python -m scripts.llm_smoke ollama       test one provider
#
# The smoke test never sends your CV or a job description, and prints no
# credential, prompt or response text.
