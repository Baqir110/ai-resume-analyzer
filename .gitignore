# ==============================================================================
# Data & runtime artifacts
# ==============================================================================
# Processing log grows on every call — do not commit
data/llm_processing.jsonl

# SQLite application database
data/applications.db
data/*.db
data/*.db-journal
data/*.sqlite

# Generated CVs, exports, uploads
data/*.pdf
data/*.docx
data/*.tex
data/*.txt
outputs/
exports/
uploads/
*.tmp

# ==============================================================================
# Backup / patch artifacts
# ==============================================================================
# Full directory backups created by restructure_project.py
app_backup_*/
app_backup_*

# In-place file backups created by every patch_*.py / fix_*.py script
*.bak_*
*.bak
*_backup.py
*.orig

# Auto-fix scripts left in the working tree (optional — comment out if you
# want them tracked)
auto_fixing_dashboard.py
patch_*.py
fix_*.py

# ==============================================================================
# OS / misc
# ==============================================================================
*.log
!data/llm_processing.jsonl   # keep the folder pattern, only gitignore that file

